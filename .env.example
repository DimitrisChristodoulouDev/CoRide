# Mobile client configuration (public values; never put service-role keys here)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Development-only Places API (New) key. Use a server proxy before production.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Restrict these native map keys to the appropriate app ID/signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=
